{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Astro pages are the app's entry points; the package scripts are the rest.
  "entry": [
    "src/pages/**/*.astro",
    "scripts/**/*.{ts,mjs}",
    "tests/e2e/**/*.spec.ts",
    // The capture config is read by a command, not imported by anything knip can
    // follow. The Playwright configs are found as configs on their own.
    "docshots.config.ts",
    // The generated capture specs import this; they are gitignored, so the module
    // has no visible importer even though it is the fixture's only consumer.
    "src/lib/docshots/capture.ts",
    // The capture fences import it through `@docshots/support`, which is Markdown to knip.
    "tests/e2e/support.ts",
    "tests/e2e/docs-library.ts",
    "tests/e2e/docs-screens.ts",
    "tests/e2e/note-guide.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,astro,css}",
    "scripts/**/*.{ts,mjs}",
    "tests/e2e/**/*.ts"
  ],
  // `react-dom` and `@types/react-dom` need no ignore entry: knip reads them as the
  // peer dependencies of the used `@astrojs/react`, and the `astro`/`knip` binaries
  // are resolved from the package scripts. Ignoring any of them would only mute a
  // real finding later.
  // A type exported for its own file's use is not dead code.
  "ignoreExportsUsedInFile": { "interface": true, "type": true }
}
