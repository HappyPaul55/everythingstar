{
  // Checked by an editor, not by a build: the schema is the published one, pinned
  // to the major that `bunx wrangler deploy` runs. Wrangler is a devDependency, so
  // its version follows `bun.lock`.
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  // The static-assets Worker the deploy uploads to. It must match the Worker in the
  // Cloudflare dashboard, which owns the custom domain and its version history.
  "name": "client-everythingstar-happypaul55-com",
  // Static assets only: `bun run build` writes `dist/` and `wrangler deploy` uploads
  // it. There is deliberately no `main` and no Worker script, because this project
  // has no API. Anything the game needs at runtime comes from the browser: playlists
  // are URLs on other projects, read over CORS.
  "compatibility_date": "2026-10-14",
  // Custom domains are managed in the Cloudflare dashboard. Explicitly disable the
  // workers.dev route and version preview URLs so neither is re-enabled on deploy.
  // Only a push to `main` deploys automatically, so there are no branch previews to
  // serve.
  "workers_dev": false,
  "preview_urls": false,
  // Inert without Workers Builds: nothing here runs `wrangler preview` any more.
  // It is kept because removing it buys nothing.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
