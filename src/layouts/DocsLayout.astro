---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import Container from "../components/ui/Container.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import { localeFromPath, tFor } from "../i18n/astro";
import { docNeighbours } from "../lib/docs/nav";
import { readableDate } from "../lib/docs/date";
import { type DocSection, docHref } from "../lib/docs/paths";
import { pageTitle } from "../lib/seo";

/**
 * The frame every documentation page shares: the sidebar, the article, the
 * page's own table of contents and the two links a reference page needs (when it
 * was last true, and where to change it).
 *
 * The documents are Markdown and nothing here adds behaviour: the contents come
 * from the heading list Astro already collects, the pager from the collection's
 * order, and the edit link from the site's own repository URL. It is a paper
 * page, so it wears the site's header and footer like the privacy notice does.
 *
 * Every box here is a utility. The article's *prose* is the only styling a
 * utility cannot express (its HTML comes from Markdown), and it lives in
 * `global.css` under `.doc`.
 */
interface Props {
  title: string;
  description: string;
  path: string;
  crumbs: { name: string; path: string }[];
  section?: DocSection;
  /** The collection id, which is also the file's path under `docs/`. */
  current?: string;
  headings?: { depth: number; slug: string; text: string }[];
  updated?: string;
  /** A page of links rather than prose: the hub gets the room it needs. */
  wide?: boolean;
}

const {
  title,
  description,
  path,
  crumbs,
  section,
  current,
  headings = [],
  updated,
  wide = false,
} = Astro.props;

const siteEntry = await getEntry("site", "main");
if (!siteEntry) throw new Error("Missing site settings entry (site/main).");
const site = siteEntry.data;

const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

const entries = await getCollection("docs");
const { previous, next } = current ? docNeighbours(entries, current) : { previous: null, next: null };

const edit = current ? `${site.repo}/blob/main/docs/${current}.md` : null;

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

// The three-column frame at a desk: the section's pages, the article, and the
// page's own contents. The hub has no section list and no contents of its own,
// so it is one centred column with the room the cards need.
const wrap = wide
  ? "mx-auto grid max-w-[64rem] grid-cols-1 gap-[clamp(1.5rem,3vw,2.5rem)] items-start"
  : "grid grid-cols-1 gap-[clamp(1.5rem,3vw,2.5rem)] items-start md:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_12rem]";

const pagerLabel = "font-mono text-[0.62rem] tracking-[0.1em] text-muted uppercase";
const pagerTitle = "text-[0.88rem] leading-[1.3]";
const pagerLink =
  "grid max-w-[48%] gap-[0.15rem] rounded-inner border border-line px-[0.8rem] py-[0.6rem] text-ink no-underline transition-colors duration-200 ease-brand hover:bg-paper-2";
const tocLink =
  "block text-[0.78rem] leading-[1.35] text-ink-soft no-underline hover:text-ink";
---

<BaseLayout
  title={pageTitle(title, site.name)}
  description={description}
  path={path}
  breadcrumbs={crumbs}
  skipHref={section ? "#doc-content" : "#main"}
>
  <main
    id="main"
    tabindex="-1"
    class="spray-paper pt-[clamp(2.25rem,5vw,3.5rem)] pb-[clamp(3rem,7vw,5rem)]"
  >
    <Container class={wrap}>
      {
        section ? (
          <DocsSidebar section={section} current={current} />
        ) : null
      }

      <article
        id="doc-content"
        tabindex="-1"
        class:list={["min-w-0", wide && "[&_.doc]:max-w-[64rem]"]}
      >
        <Breadcrumbs items={crumbs.slice(1, -1)} />
        <h1 class="mt-3 font-display text-[clamp(2rem,5vw,3rem)] leading-[1.02]">{title}</h1>
        <div class="doc mt-6">
          <slot />
        </div>

        <footer
          class="mt-10 flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-line pt-[0.9rem] font-mono text-[0.7rem] tracking-[0.03em] text-muted"
        >
          {
            updated ? (
              <span>{t("docs.updated", { date: readableDate(updated) })}</span>
            ) : null
          }
          {
            edit ? (
              <a
                class="border-b border-yellow text-ink-soft no-underline hover:text-ink"
                href={edit}
                rel="noreferrer"
              >
                {t("docs.edit")} ↗
              </a>
            ) : null
          }
        </footer>

        {
          previous || next ? (
            <nav class="mt-5 flex justify-between gap-4" aria-label={t("docs.nav")}>
              {previous ? (
                <a class={pagerLink} href={docHref(previous.id, locale)}>
                  <span class={pagerLabel}>{t("docs.previous")}</span>
                  <span class={pagerTitle}>{previous.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a class:list={[pagerLink, "ml-auto text-right"]} href={docHref(next.id, locale)}>
                  <span class={pagerLabel}>{t("docs.next")}</span>
                  <span class={pagerTitle}>{next.data.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          ) : null
        }
      </article>

      {
        toc.length > 0 ? (
          <nav
            class="mt-[1.5rem] hidden xl:sticky xl:top-5 xl:block"
            aria-label={t("docs.onThisPage")}
          >
            <p class="mb-[0.6rem] inline-block kicker text-muted">{t("docs.onThisPage")}</p>
            <ul class="m-0 grid list-none gap-[0.2rem] p-0">
              {toc.map((heading) => (
                <li class:list={[heading.depth === 3 && "pl-[0.6rem]"]}>
                  <a class={tocLink} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null
      }
    </Container>
  </main>
</BaseLayout>
