---
import { getCollection } from "astro:content";
import { localeFromPath, tFor } from "../../i18n/astro";
import { localePath } from "../../i18n/paths";
import { docGroups } from "../../lib/docs/nav";
import { type DocSection, docHref } from "../../lib/docs/paths";
import { SECTION_LABELS } from "../../lib/docs/sections";

/**
 * The docs sidebar: the pages of the section being read.
 *
 * The four sections are **not** repeated here — the breadcrumb trail above the
 * article already says where you are, and its `Documentation` crumb is the way
 * back to the hub. What the sidebar adds is the one thing the trail cannot: the
 * other pages beside this one. The documents come from the collection, so a new
 * page is a new file and a line in the hub, never a link list here; the current
 * page is marked with `aria-current`.
 *
 * On a phone the sidebar steps aside entirely: the trail, the pager and the hub
 * are the navigation, and a list of ten pages above the article would push the
 * page itself below the fold.
 */
interface Props {
  section: DocSection;
  current?: string;
}

const { section, current } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
const groups = docGroups(await getCollection("docs"));
const pages = groups.find((group) => group.section === section)?.docs ?? [];

const pageLink =
  "block rounded-inner border-l-2 border-transparent px-2 py-[0.28rem] text-[0.86rem] leading-[1.35] text-ink-soft no-underline hover:bg-paper-2 hover:text-ink aria-[current=page]:border-l-yellow aria-[current=page]:bg-paper-2 aria-[current=page]:font-semibold aria-[current=page]:text-ink";
---

<aside class="hidden min-w-0 md:sticky md:top-5 md:block">
  <a
    class="mb-[0.6rem] inline-block font-mono text-[0.68rem] tracking-[0.12em] text-muted uppercase no-underline hover:text-ink"
    href={localePath(locale, "/docs")}>{t("docs.title")}</a
  >
  <nav aria-label={t(SECTION_LABELS[section])}>
    <p class="mt-[1.4rem] mb-[0.35rem] font-display text-[1.02rem]">{t(SECTION_LABELS[section])}</p>
    <ul class="m-0 grid list-none gap-[0.1rem] p-0">
      {
        pages.map((page) => (
          <li>
            <a
              class={pageLink}
              href={docHref(page.id, locale)}
              aria-current={page.id === current ? "page" : undefined}
            >
              {page.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
