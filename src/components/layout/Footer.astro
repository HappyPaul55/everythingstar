---
import type { SiteSettings } from "../../lib/site";
import Container from "../ui/Container.astro";
import Mark from "../ui/Mark.astro";
import { localeFromPath, tFor } from "../../i18n/astro";
import { localePath } from "../../i18n/paths";
import { siteNav } from "../../lib/nav";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
const year = new Date().getFullYear();
const domain = settings.url.replace(/^https?:\/\//, "").replace(/\/$/, "");

const nav = siteNav(locale, t);

const link =
  "font-mono text-[0.78rem] font-bold uppercase tracking-[0.06em] text-[rgba(250,250,244,0.66)] transition-colors duration-200 ease-brand hover:text-yellow";
const heading =
  "font-display text-[1.05rem] text-[rgba(250,250,244,0.7)]";
---

<footer class="on-ink spray-ink pt-[clamp(3rem,7vw,5rem)] pb-8">
  <div class="hazard" aria-hidden="true"></div>
  <Container class="pt-[clamp(2rem,5vw,3.5rem)]">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a class="inline-flex items-center gap-[0.6rem]" href={localePath(locale, "/")}>
          <Mark size={30} />
          <span class="font-display text-[1.3rem] text-cream"
            >{settings.name}</span
          >
        </a>
        <p
          class="mt-4 max-w-[24rem] text-[0.95rem] leading-[1.6] text-[rgba(250,250,244,0.62)]"
        >
          {t("site.tagline")}.
        </p>
      </div>

      <nav aria-label={t("footer.nav")} class="no-print">
        <h2 class={heading}>{t("footer.pages")}</h2>
        <ul class="mt-4 grid gap-[0.7rem]">
          {
            nav.map((item) => (
              <li>
                <a class={link} href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="no-print">
        <h2 class={heading}>{t("footer.elsewhere")}</h2>
        <ul class="mt-4 grid gap-[0.7rem]">
          <li>
            <a
              class={link}
              href={settings.repo}
              target="_blank"
              rel="noopener noreferrer">{t("footer.source")} ↗</a
            >
          </li>
          <li>
            <a
              class={link}
              href={settings.licenseUrl}
              target="_blank"
              rel="noopener noreferrer"
              >{t("footer.licence", { licence: settings.license })} ↗</a
            >
          </li>
          <li>
            <a
              class={link}
              href={settings.authorUrl}
              target="_blank"
              rel="noopener noreferrer">{settings.author} ↗</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-[clamp(2.5rem,5vw,4rem)] flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line-ink pt-6 text-[0.78rem] text-[rgba(250,250,244,0.6)]"
    >
      <span>
        © {year}{" "}
        <a
          class="underline decoration-[rgba(250,250,244,0.35)] underline-offset-2 transition-colors duration-200 ease-brand hover:text-yellow"
          href={settings.authorUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {settings.author}
        </a>{" "}
        · {domain}
      </span>
      <span class="font-mono">{t("footer.private")}</span>
    </div>
  </Container>
</footer>
