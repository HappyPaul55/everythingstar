---
import { localeFromPath, tFor } from "../../i18n/astro";
import { localePath } from "../../i18n/paths";

/**
 * The trail above a paper page: the `//` home mark, then the ancestors of the
 * page.
 *
 * The wordmark already goes home, and so does the mark; the page's own name is its
 * `h1`, so neither is repeated here. What is left is the path that got you here —
 * `Documentation / Players` on a documentation page. A page with no ancestors (the
 * hub, a notice) has no trail at all, so nothing is drawn: a lone `//` is a control
 * with no answer to the question a breadcrumb asks.
 *
 * The separator is a span between the items rather than a `::before` on each: it is
 * one character, and the markup already has a place for it. It is also the reason
 * this file has no stylesheet left — the trail is the tag's look plus a list.
 */
interface Crumb {
  name: string;
  path: string;
}

interface Props {
  /** The page's ancestors, outermost first. Not home, not this page. */
  items: Crumb[];
}

const { items } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
---

{
  items.length > 0 ? (
    <nav class="comment flex flex-wrap items-center gap-x-2 gap-y-1" aria-label={t("nav.breadcrumb")}>
      <a
        class="inline-flex items-center leading-none text-inherit no-underline hover:[&_.slash]:text-ink"
        href={localePath(locale, "/")}
        aria-label={t("nav.home")}
      >
        <span class="slash" aria-hidden="true">//</span>
      </a>
      {
        items.map((crumb, index) => (
          <>
            {index > 0 ? (
              <span class="text-[0.7em] opacity-50" aria-hidden="true">
                /
              </span>
            ) : null}
            <a
              class="text-inherit no-underline transition-colors duration-200 ease-brand hover:text-yellow-deep"
              href={crumb.path}
            >
              {crumb.name}
            </a>
          </>
        ))
      }
    </nav>
  ) : null
}
