---
import type { SiteSettings } from "../../lib/site";
import Container from "../ui/Container.astro";
import Mark from "../ui/Mark.astro";
import { localeFromPath, tFor } from "../../i18n/astro";
import { localePath } from "../../i18n/paths";
import { siteNav } from "../../lib/nav";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

// Play, Docs and Privacy; the pill for Play stands out from the plain links.
const nav = siteNav(locale, t).filter((item) => item.href !== "/play");

// `build.format: "file"` means Astro.url.pathname is /play.html at build time,
// while the served URL is extensionless. Normalise both sides before comparing.
const normalizePath = (value: string) =>
  value
    .replace(/index\.html$/, "")
    .replace(/\.html$/, "")
    .replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const path = normalizePath(Astro.url.pathname);
  const target = normalizePath(href);
  // Docs is a section: every page under it keeps the header's Docs link lit, so
  // a reader always knows which part of the site they are in.
  if (target === "/docs") return path === "/docs" || path.startsWith("/docs/");
  return path === target;
};

const current = (href: string) => (isActive(href) ? "page" : undefined);
const playHref = localePath(locale, "/play");

// The two looks a navigation link takes: a plain label in the bar, and the
// outlined pill for Play. The panel repeats both on paper.
const barLink =
  "transition-colors duration-200 ease-brand hover:text-yellow aria-[current=page]:text-yellow";
const barPill =
  "inline-flex items-center gap-[0.35rem] rounded-pill border border-line-ink-strong px-[0.9rem] py-2 text-cream transition-colors duration-200 ease-brand hover:border-yellow hover:bg-yellow hover:text-ink aria-[current=page]:border-yellow aria-[current=page]:text-yellow";
const panelLink =
  "block rounded-inner px-[0.85rem] py-[0.8rem] text-ink transition-colors duration-200 ease-brand hover:bg-[color-mix(in_srgb,var(--color-yellow)_45%,#fff)] aria-[current=page]:bg-yellow";
---

<header id="site-header" class="on-ink no-print relative z-30 bg-ink">
  <div class="hazard h-[5px]" aria-hidden="true"></div>
  <Container class="relative flex items-center justify-between gap-6 py-[0.9rem]">
    <a class="inline-flex items-center gap-[0.6rem]" href={localePath(locale, "/")}>
      <Mark size={30} />
      <span class="font-display text-[1.15rem] leading-none text-cream sm:text-[1.3rem]">
        {settings.name}
      </span>
    </a>

    <nav
      class="hidden items-center gap-[1.7rem] font-mono text-[0.74rem] font-bold tracking-[0.06em] text-cream/66 uppercase min-[861px]:flex"
      aria-label={t("nav.primary")}
    >
      {
        nav.map((item) => (
          <a class={barLink} href={item.href} aria-current={current(item.href)}>
            {item.label}
          </a>
        ))
      }
      <a class={barPill} href={playHref} aria-current={current(playHref)}
        >{t("nav.play")}</a
      >
    </nav>

    <details class="min-[861px]:hidden [&[open]>nav]:flex">
      <summary
        class="grid h-11 w-11 cursor-pointer list-none place-items-center rounded-brand border border-line-ink-strong text-cream transition-colors duration-200 ease-brand hover:border-yellow [&::-webkit-details-marker]:hidden"
        aria-label={t("nav.menu")}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav
        class="absolute inset-x-0 top-[calc(100%+0.65rem)] hidden flex-col items-stretch gap-[0.15rem] rounded-brand border-x-2 border-b-2 border-t-[5px] border-ink border-t-yellow bg-cream p-[0.55rem] font-mono text-[0.74rem] font-bold tracking-[0.06em] uppercase shadow-sticker"
        aria-label={t("nav.primary")}
      >
        {
          nav.map((item) => (
            <a class={panelLink} href={item.href} aria-current={current(item.href)}>
              {item.label}
            </a>
          ))
        }
        <a
          class="block rounded-inner bg-yellow px-[0.85rem] py-[0.8rem] text-center text-ink transition-colors duration-200 ease-brand hover:bg-yellow-deep"
          href={playHref}
          aria-current={current(playHref)}>{t("nav.play")}</a
        >
      </nav>
    </details>
  </Container>
</header>
