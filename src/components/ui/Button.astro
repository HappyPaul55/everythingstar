---
import { buttonClass, type ButtonVariant } from "../../lib/button";

interface Props {
  href?: string;
  variant?: ButtonVariant;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  class: className = "",
  ...rest
} = Astro.props;

const cls = buttonClass(variant, className);
---

{
  href ? (
    <a href={href} class={cls} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={cls} {...rest}>
      <slot />
    </button>
  )
}
