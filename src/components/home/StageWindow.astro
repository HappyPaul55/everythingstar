---
/**
 * The homepage's live window: the game playing itself, in a phone-shaped screen.
 *
 * It is an **iframe** of `/arcade`, not another island in this page. The game wants
 * a document of its own — a viewport, a theme, keyboard and focus, a service worker
 * — and borrowing the marketing page's for it would make the hero's accessibility
 * and scrolling the game's. The iframe keeps all of that on the other side of a
 * boundary and leaves this page with no JavaScript of its own.
 *
 * `players=1&sound=0&demo=1&chrome=0` is the home window: one player, the frame
 * clock rather than a mixer and the song's audio, no idle, and no fullscreen corner.
 *
 * **The whole frame is a link into the game.** The iframe itself is decoration: it
 * is `aria-hidden` and out of the tab order, and it takes no pointer events, so the
 * picture inside cannot trap a press or a screen reader's cursor. The anchor laid
 * over it is the real control — focusable, named "Play EverythingStar", and wearing
 * the ink-and-yellow outline on hover and on focus — while the caption link below
 * stays the visible one. A play plaque over the picture would cover the hit line the
 * demo exists to show; an outline around the frame says the same thing without it.
 */
import { localeFromPath, tFor } from "../../i18n/astro";
import { localePath } from "../../i18n/paths";

const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
const play = localePath(locale, "/play");
const windowUrl = `${localePath(locale, "/arcade")}?players=1&sound=0&demo=1&chrome=0`;
---

<div class="relative mx-auto w-full max-w-[21rem]">
  <div
    class="relative aspect-[9/16] overflow-hidden rounded-brand border-[3px] border-ink bg-ink shadow-[10px_10px_0_var(--color-yellow)]"
  >
    <iframe
      class="pointer-events-none absolute inset-0 h-full w-full border-0"
      src={windowUrl}
      title={t("home.stageDemo")}
      loading="lazy"
      tabindex="-1"
      aria-hidden="true"
    ></iframe>
    <a
      class="stage-window__link absolute inset-0 z-10 rounded-brand"
      href={play}
      aria-label={t("home.stagePlay")}
    ></a>
  </div>
  <div class="mt-4 flex items-baseline justify-between gap-3">
    <p
      class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-[rgba(250,250,244,0.55)]"
    >
      {t("home.stageCaption")}
    </p>
    <a
      class="shrink-0 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-yellow no-underline hover:text-cream focus-visible:outline-cream"
      href={play}
      aria-label={t("home.stagePlay")}
    >
      {t("home.ctaPlay")} <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  /*
   * The frame's link says it is pressable without covering the song.
   *
   * An outline is drawn outside the box, so neither the hover nor the focus ring
   * moves the frame or covers the picture: the colour is what changes. The ink
   * casing is always there (transparent) so the ring can appear in one paint, and
   * the yellow is the house focus colour on the dark hero. The site's own
   * `:focus-visible` rule is overridden here only to keep the ring outside the
   * frame, which is the thing being linked.
   */
  .stage-window__link {
    outline: 3px solid transparent;
    outline-offset: 4px;
    transition: outline-color 120ms ease;
  }

  .stage-window__link:hover,
  .stage-window__link:focus-visible {
    outline-color: var(--color-yellow);
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-window__link {
      transition: none;
    }
  }
</style>
