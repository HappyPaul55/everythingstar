---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import { localeFromPath, tFor } from "../i18n/astro";
import { localePath } from "../i18n/paths";
import { pageTitle } from "../lib/seo";

const site = (await getEntry("site", "main"))!.data;
const entry = await getEntry("legal", "privacy");
if (!entry) throw new Error("Missing privacy notice (legal/privacy).");
const { Content } = await render(entry);
const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
// One trail: the visible `//` crumbs and the SEO JSON-LD use the same shape.
const crumbs = [
  { name: t("nav.home"), path: localePath(locale, "/") },
  { name: t("nav.privacy"), path: localePath(locale, "/privacy") },
];
---

<BaseLayout
  title={pageTitle(entry.data.title, site.name)}
  description={entry.data.description}
  path={localePath(locale, "/privacy")}
  breadcrumbs={crumbs}
>
  <main id="main" tabindex="-1" class="spray-paper py-[clamp(3rem,8vw,5.5rem)]">
    <Container>
      <article class="legal">
        <Breadcrumbs items={crumbs} />
        <h1
          class="mt-4 font-display text-[clamp(2rem,6vw,3.25rem)] leading-[1.03]"
        >
          {entry.data.title}
        </h1>
        <p
          class="mt-3 font-mono text-[0.78rem] font-bold tracking-[0.08em] text-muted uppercase"
        >
          {t("privacy.updated", { date: entry.data.updated })}
        </p>
        <div class="mt-8">
          <Content />
        </div>
      </article>
    </Container>
  </main>
</BaseLayout>
