---
import { getCollection, getEntry, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { localeFromPath, tFor } from "../../i18n/astro";
import { localePath } from "../../i18n/paths";
import { docGroups } from "../../lib/docs/nav";
import { docHref } from "../../lib/docs/paths";
import { SECTION_LABELS, SECTION_LEDES } from "../../lib/docs/sections";

/**
 * The docs hub: `docs/README.md`'s own introduction, then every section as a
 * list — the whole documentation on one page, which is what makes it findable
 * without a client-side search.
 */
const hub = await getEntry("docs", "README");
if (!hub) throw new Error("Missing the documentation hub (docs/README.md).");

const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
const { Content } = await render(hub);
const groups = docGroups(await getCollection("docs"));

const crumbs = [
  { name: t("nav.home"), path: localePath(locale, "/") },
  { name: t("docs.title"), path: localePath(locale, "/docs") },
];
const title = hub.data.title;
---

<DocsLayout
  title={title}
  description={hub.data.description}
  path={localePath(locale, "/docs")}
  crumbs={crumbs}
  updated={hub.data.updated}
  wide
>
  <Content />

  <div class="mt-10 grid gap-8 md:grid-cols-2 md:gap-x-12 md:gap-y-10">
    {
      groups.map((group) => (
        <section class="scroll-mt-4 border-t-2 border-ink pt-4" id={group.section}>
          <h2 class="mt-0 border-0 p-0 font-display text-[1.5rem] leading-[1.1] font-normal">
            {t(SECTION_LABELS[group.section])}
          </h2>
          <p class="mt-[0.35rem] max-w-[46rem] text-[0.95rem] text-ink-soft">
            {t(SECTION_LEDES[group.section])}
          </p>
          <ul class="mt-[0.9rem] grid list-none gap-[0.35rem] p-0">
            {group.docs.map((doc) => (
              <li>
                <a
                  class="grid gap-[0.1rem] rounded-inner border border-line px-[0.75rem] py-[0.55rem] text-ink no-underline transition-colors duration-200 ease-brand hover:bg-paper-2"
                  href={docHref(doc.id, locale)}
                >
                  <span class="font-semibold">{doc.data.title}</span>
                  <span class="text-[0.86rem] leading-[1.45] text-ink-soft">
                    {doc.data.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</DocsLayout>
